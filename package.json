{
  "name": "stratdeck",
  "private": true,
  "version": "1.0.0",
  "description": "A Discord-authored tactical strategy reader for teams.",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test web",
    "build": "tsc && vite build",
    "dev": "tsx watch src/server.ts",
    "export": "tsx src/cli/export.ts",
    "password": "tsx src/cli/password.ts",
    "validate-export": "tsx src/cli/validate-export.ts",
    "validate-export-file": "tsx src/cli/validate-export.ts",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node dist/src/server.js",
    "frontend:dev": "vite --host 127.0.0.1",
    "start:fixture": "tsx src/cli/fixture-server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naheedroomy/stratdeck.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/naheedroomy/stratdeck/issues"
  },
  "homepage": "https://github.com/naheedroomy/stratdeck#readme",
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
